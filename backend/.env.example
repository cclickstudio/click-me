# ──────────────────────────────────────────────
# ClickMe backend .env.example — 코드가 실제로 읽는 키만 수록 (2026-07-08 사용처 전수 검증)
# 미사용으로 확인되어 제외한 키: APP_HOST / APP_PORT / LOG_LEVEL / DEFAULT_PERSONA_COUNT /
#   MAX_PERSONA_COUNT / META_USER_ID / META_PAGE_ACCESS_TOKEN / GEMINI_IMAGE_API_KEY /
#   CHAT_CLASSIFY_MODEL / CHAT_ORCHESTRATOR_TEMPERATURE / CHAT_PROVIDER / SQS_*
#   (소비 코드가 생기면 다시 추가)
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production (트레이싱·리다이렉트 분기)
INTERNAL_API_BASE_URL=http://localhost:8000   # 매니지먼트→제너레이터 내부 HTTP 호출 베이스
FRONTEND_BASE_URL=http://localhost:3000       # Meta OAuth 콜백 후 복귀할 프론트 주소
CORS_ALLOW_ORIGINS=                           # 추가 허용 origin(콤마 구분). 예: https://clickme.co.kr
# 내부 서비스 호출 토큰(서버끼리) — live(use_mock=false)에서 from-candidate 401 방지. 미설정(dev)이면 검사 생략.
INTERNAL_SERVICE_TOKEN=

# ──────────────────────────────────────────────
# Auth (인증)
# ──────────────────────────────────────────────
# local(기본): 자체 HS256 JWT. cognito: AWS Cognito 토큰을 JWKS(RS256)로 검증 — 운영 기준.
AUTH_PROVIDER=local                            # local | cognito
JWT_SECRET=clickme-dev-secret-change-in-prod   # AUTH_PROVIDER=local 일 때만 사용
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080                       # 7일
# AUTH_PROVIDER=cognito 일 때 아래 3개 필수(미설정 시 기동 거부).
# 규약: Cognito username = 우리 login_id (DB User.login_id 매핑, 스키마 변경 없음).
COGNITO_REGION=                                # 미설정 시 AWS_REGION 사용 (예: us-west-2)
COGNITO_USER_POOL_ID=                          # 예: us-west-2_xxxxxxxxx
COGNITO_APP_CLIENT_ID=                         # 앱 클라이언트 ID = ID 토큰 audience(aud)

# ──────────────────────────────────────────────
# Database (NeonDB / PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# LLM API Keys
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...              # 필수 — 채팅·생성·임베딩·시뮬 폴백
ANTHROPIC_API_KEY=sk-ant-...       # 필수 — 페르소나 토론 Judge(Haiku)
GEMINI_API_KEY=AIza...             # 시뮬 반응·VLM·이미지(gemini 모드)
TAVILY_API_KEY=                    # 매니지먼트 어시스턴트 web_search — 없으면 graceful 비활성

# ──────────────────────────────────────────────
# Embedding (KB·롱텀메모리 공유 — 동일 모델·차원 필수)
# ──────────────────────────────────────────────
EMBEDDING_PROVIDER=openai          # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                 # ⚠ 사실상 고정 — DB 컬럼이 vector(1536) 하드고정이라 변경 시 마이그레이션 필요

# ──────────────────────────────────────────────
# Chat (통합 딥에이전트)
# ──────────────────────────────────────────────
CHAT_ORCHESTRATOR_PROVIDER=openai  # anthropic | openai | google_genai
CHAT_ORCHESTRATOR_MODEL=gpt-4.1

# ──────────────────────────────────────────────
# LangSmith (AI 파이프라인 트레이싱)
# ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...      # 없으면 트레이싱 비활성(로컬 기동 가능)
LANGCHAIN_PROJECT=clickme

# ──────────────────────────────────────────────
# AWS / S3
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
S3_BUCKET_NAME=clickme-assets

# ──────────────────────────────────────────────
# Meta / Instagram (Marketing API + Content Publishing)
# ──────────────────────────────────────────────
USE_MOCK=true                      # true=Mock(데모·기본) / false=실연동. wiring.py 분기 기준
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=                  # 현재 scripts/meta_review_probe.py 전용
META_AD_ACCOUNT_ID=                # act_ 접두사 포함
META_PAGE_ID=
META_IG_USER_ID=                   # 인스타 비즈니스 계정 숫자 ID (별칭: META_INSTAGRAM_ACCOUNT_ID)
# 멀티테넌트 Meta 토큰 암호화 키(AES-256, base64 32B) — 없으면 org별 연결 저장 불가
META_TOKEN_ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# Management (4-2 광고 매니지먼트)
# ──────────────────────────────────────────────
# 집행 모드: dry_run(쓰기 검증만, Meta 변경 0) | validate_only | live(실집행)
# ★ USE_MOCK=false + 토큰 보유 상태에서 live면 실제 광고가 집행·과금됨 → 기본 dry_run 유지
MANAGEMENT_EXECUTION_MODE=dry_run
# 캠페인 생성 시 광고(소재)까지 만들지 여부 — Meta access level(1885183) 확보 후 true
MANAGEMENT_CREATE_AD=false
# 진단 agent LLM (키 없으면 결정론 폴백)
MANAGEMENT_DIAGNOSIS_MODEL=gpt-4o-mini
MANAGEMENT_DIAGNOSIS_TEMPERATURE=0.0
# 어시스턴트 ReAct 그래프 LLM
MANAGEMENT_ASSISTANT_MODEL=gpt-4o-mini
# 집행 권장 게이트(판정 정본은 contracts/policy.py — 코드 수정 없는 조정 채널)
MANAGEMENT_EXEC_GATE_MIN_CIR=0.01  # 클릭 의향률 하한(포함)
MANAGEMENT_EXEC_GATE_MAX_REJ=0.2   # 거부율 상한(미만)
# 매니지먼트 reader만 mock 강제(알림 데모) — 전역 use_mock과 분리, 채팅 live 유지
MANAGEMENT_READER_MOCK=false

# — 능동 스케줄러(APScheduler 워커: 이상 스캔·주간 리포트·리밸런스 제안) — 기본 off, 운영에서만 켠다
MANAGEMENT_SCHEDULER_ENABLED=false
MANAGEMENT_SCAN_INTERVAL_MINUTES=60
MANAGEMENT_WEEKLY_REPORT_INTERVAL_MINUTES=10080   # 주1회
MANAGEMENT_REBALANCE_INTERVAL_MINUTES=1440        # 일1회(제안만 — 실행은 사람 승인)
MANAGEMENT_SCANNER_MODE=agent      # rule(결정론 규칙) | agent(에이전트 판단)
MANAGEMENT_DEFAULT_TARGET_ROAS=    # 미설정이면 성과 진단 생략(목표를 지어내지 않음)
# ⚠ 스캔 임계값은 env로 조정 불가 — contracts/policy.py 하드코딩(코드 수정 필요):
#   지갑 경고/알림 80%/95%(WALLET_WARN/ALERT_PCT) · 소재 피로 빈도(FATIGUE_FREQUENCY)
#   월 목표 예산(DEFAULT_MONTHLY_TARGET_KRW) · 기본 일예산(DAILY_BUDGET_KRW)

# — 이상 알림 배달
# ⚠ 채널은 예약 스케줄러에만 엄격 적용 — 수동 notify-scan은 panel 외 값(log 포함)이면 chat sink로 시연 동작 유지
MANAGEMENT_NOTIFY_CHANNEL=log      # log | chat | panel
MANAGEMENT_NOTIFY_SSE_ENABLED=true # 알림 SSE(단일 프로세스 전제) — 멀티워커면 끈다
MANAGEMENT_CONSULT_COOLDOWN_HOURS=24        # 같은 캠페인·이상 재통지 최소 간격
MANAGEMENT_CONSULT_CONTEXT_TTL_HOURS=24     # consult 컨텍스트 채팅 주입 유효시간
MANAGEMENT_SCAN_MANUAL_COOLDOWN_SECONDS=60  # 수동 notify-scan org별 재요청 간격(429 방지)

# ──────────────────────────────────────────────
# Simulation (4-1) — 503 내성 · 반응 엔진
# ──────────────────────────────────────────────
SIMULATION_MAX_CONCURRENCY=8       # 반응 fan-out 동시성 상한
SIMULATION_LLM_PROVIDER=gemini     # gemini | openai — 과부하 시 전체 공급자 전환
SIMULATION_REACTION_GEMINI_MODEL=gemini-3.5-flash   # 반응 생성(4-b) 모델
SIMULATION_VLM_GEMINI_MODEL=gemini-2.5-flash        # 광고해석(4-a, VLM) 모델
# ⚠ 루브릭·QA 모델은 env로 조정 불가 — 코드 내 별도 상수(위 두 키는 반응·해석에만 적용)
SIMULATION_GEMINI_MODEL=gemini-3.5-flash           # 503 과부하 우회 모델 교체(예: gemini-flash-latest)
SIMULATION_REACTION_FALLBACK=1     # Gemini 실패 시 GPT 폴백(0/false 끔, OPENAI 키 필요)
SIMULATION_REACTION_FALLBACK_MODEL=gpt-4.1-mini
SIMULATION_OPENAI_JSON_MODEL=gpt-4.1-mini   # openai 공급자 모드 JSON 호출 모델
SIMULATION_SCORING=llm             # llm | ssr(임베딩 스코어러 — 데이터 확보 후 전환)
SIM_LLM_QA=0                       # 1이면 시뮬 LLM QA 게이트 활성

# ──────────────────────────────────────────────
# Generator (4-3 광고 생성)
# ──────────────────────────────────────────────
# 생성 방식: openai=OpenAI 이미지(상품있음 누끼·인페인팅 / 없음 0부터)
#            gemini=Gemini 멀티모달(이미지+카피 동시 생성, 상품있음 멀티모달 입력)
GENERATOR_GEN_MODE=openai                 # openai | gemini

# [생성 방식: gemini] GEN_MODE=gemini 일 때만 사용 — native 모델이 이미지+카피를 한 호출로 출력
GENERATOR_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 교체 예: gemini-3-pro-image | gemini-3.1-flash-image | gemini-2.5-flash-image

# [텍스트 생성] 상품분석·전략·카피·QA·설명 (structured output 지원 모델만, 두 모드 공통)
GENERATOR_TEXT_PROVIDER=openai        # openai | anthropic | google_genai
GENERATOR_TEXT_MODEL=gpt-4.1
GENERATOR_TEXT_BASE_URL=              # OpenAI 호환 프록시 엔드포인트(선택)

# [비전(이미지 분석)]
GENERATOR_VISION_PROVIDER=openai      # openai | google_genai
GENERATOR_VISION_MODEL=gpt-4o

# [이미지 생성] 배경 이미지
GENERATOR_IMAGE_PROVIDER=openai         # openai | google_genai
GENERATOR_IMAGE_MODEL=gpt-image-1
GENERATOR_IMAGE_QUALITY=medium          # low | medium | high (openai 전용)
GENERATOR_IMAGE_TIMEOUT=120             # 무거운 이미지 모델 대비 호출 타임아웃(초)

# [이미지 편집] 누끼 배경제거 폴백 (현재 openai만 구현)
GENERATOR_IMAGE_EDIT_PROVIDER=openai
GENERATOR_IMAGE_EDIT_MODEL=gpt-image-1

# [작업별 오버라이드] 미설정 시 폴백 — 누끼: IMAGE_EDIT_* · 인페인팅: IMAGE_* (openai 전용)
GENERATOR_CUTOUT_PROVIDER=openai
GENERATOR_CUTOUT_MODEL=gpt-image-1
GENERATOR_CUTOUT_QUALITY=low
GENERATOR_INPAINT_PROVIDER=openai
GENERATOR_INPAINT_MODEL=gpt-image-1
GENERATOR_FONT_DIR=                   # 없으면 시스템 임시 폴더에 폰트 캐시

# — 제너레이터 자동화 워커(품질 다이제스트·멈춘 생성 감지) — 기본 off
GENERATOR_SCHEDULER_ENABLED=false
GENERATOR_QUALITY_DIGEST_INTERVAL_MINUTES=1440   # 일1회
GENERATOR_STUCK_SCAN_INTERVAL_MINUTES=30
GENERATOR_STUCK_THRESHOLD_MINUTES=30             # pending/running 갱신 없음 판정 임계

# ──────────────────────────────────────────────
# Billing (Toss Payments)
# ──────────────────────────────────────────────
# ⚠ 사실상 고정 — config.py validator가 test_ 접두사 키만 허용(라이브 키 주입 시 기동 거부, 실 과금 봉인)
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

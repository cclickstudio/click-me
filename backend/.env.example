# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
INTERNAL_API_BASE_URL=http://localhost:8000   # 도메인 간 내부 HTTP 호출 베이스(generator↔management)
FRONTEND_BASE_URL=http://localhost:3000       # OAuth 콜백 후 복귀할 프론트 주소

# ──────────────────────────────────────────────
# Auth (인증 — 점진 도입 플래그)
# ──────────────────────────────────────────────
# local(기본): 자체 HS256 JWT(/api/auth/login). cognito: AWS Cognito 토큰을 JWKS로 검증.
AUTH_PROVIDER=local                            # local | cognito
JWT_SECRET=clickme-dev-secret-change-in-prod   # AUTH_PROVIDER=local 일 때만 사용
# AUTH_PROVIDER=cognito 일 때만 필요. User Pool은 AWS 콘솔에서 생성(자가가입 off).
# 규약: Cognito username = 우리 login_id (DB User.login_id 로 매핑, 스키마 변경 없음).
COGNITO_REGION=                                # 미설정 시 AWS_REGION 사용 (예: us-west-2)
COGNITO_USER_POOL_ID=                          # 예: ap-northeast-2_xxxxxxxxx
COGNITO_APP_CLIENT_ID=                         # 앱 클라이언트 ID = ID 토큰 audience(aud)

# ──────────────────────────────────────────────
# Mode / Management (광고 매니지먼트)
# ──────────────────────────────────────────────
USE_MOCK=true                       # true=Mock(데모·기본) / false=실연동(Meta 등). wiring.py 분기 기준
# 캠페인 생성 시 광고(소재)까지 만들지 여부.
# false=캠페인+광고세트까지만(Meta access level 전 code 100/1885183 회피).
# Marketing API Access Tier/Advanced 확보 후 true로 바꾸면 광고까지 풀 생성.
MANAGEMENT_CREATE_AD=false
MANAGEMENT_EXECUTION_MODE=dry_run        # dry_run | validate_only | live (use_mock=false일 때만 적용)
MANAGEMENT_DIAGNOSIS_MODEL=gpt-4o-mini   # 진단 agent LLM (키 없으면 결정론 폴백)
MANAGEMENT_DIAGNOSIS_TEMPERATURE=0.0

# ──────────────────────────────────────────────
# Database (NeonDB / PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# LLM — OpenAI
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# LLM — Anthropic
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# LLM — Google Gemini (채팅 어드바이저)
# ──────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ──────────────────────────────────────────────
# Simulation (4-1) — 503 내성 · 반응 엔진
# ──────────────────────────────────────────────
# 반응 fan-out 동시성 상한(과부하 엔드포인트 동시 폭주 방지). 미설정 시 8.
SIMULATION_MAX_CONCURRENCY=8
# 제미나이 반응 실패(재시도 소진) 시 GPT 폴백. 0/false면 끔. 기본 ON이나 OPENAI_API_KEY 있을 때만 작동.
SIMULATION_REACTION_FALLBACK=1
# 폴백에 쓸 OpenAI 모델(고볼륨·저비용·JSON mode). 미설정 시 gpt-4.1-mini.
SIMULATION_REACTION_FALLBACK_MODEL=gpt-4.1-mini

# ──────────────────────────────────────────────
# LangSmith (AI 파이프라인 트레이싱)
# ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=clickme

# ──────────────────────────────────────────────
# AWS
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# S3
S3_BUCKET_NAME=clickme-assets

# SQS
SQS_SIMULATION_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/...
SQS_MAX_WORKERS=10

# ──────────────────────────────────────────────
# Simulation
# ──────────────────────────────────────────────
DEFAULT_PERSONA_COUNT=20
MAX_PERSONA_COUNT=1000

# ───────── Meta / Instagram (Marketing API + Content Publishing) ─────────
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0                          
META_APP_ID=
META_APP_SECRET=      
META_BUSINESS_ID=     
META_AD_ACCOUNT_ID=   
META_PAGE_ID=         
META_IG_USER_ID=      
USE_MOCK=false
# 멀티테넌트 Meta 토큰 암호화 키 (AES-256, base64 32B)
META_TOKEN_ENCRYPTION_KEY=

# ───────── Management (4-2 광고 매니지먼트) ─────────
# 집행 모드: dry_run(쓰기 검증만, Meta 변경 0) | validate_only | live(실집행)
# ★ USE_MOCK=false + 토큰 보유 상태이므로 live로 두면 실제 광고가 집행됨 → dry_run 유지
MANAGEMENT_EXECUTION_MODE=dry_run
# 진단 agent LLM ReAct 재현성 고정값 (키 없으면 결정론 폴백)
MANAGEMENT_DIAGNOSIS_MODEL=gpt-4o-mini
MANAGEMENT_DIAGNOSIS_TEMPERATURE=0.0

# ──────────────────────────────────────────────
# Generator (광고 생성)
# ──────────────────────────────────────────────
# 생성 방식: openai=OpenAI 이미지(상품있음 누끼·인페인팅 / 없음 0부터)
#            gemini=Gemini 멀티모달(이미지+카피 동시 생성, 상품있음 멀티모달 입력)
GENERATOR_GEN_MODE=openai                 # openai | gemini

# [생성 방식: gemini] GEN_MODE=gemini 일 때만 사용 — native 모델이 이미지+카피를 한 호출로 출력
GENERATOR_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 교체 예: gemini-3-pro-image | gemini-3.1-flash-image | gemini-2.5-flash-image

# [openai 모드 / 공통] 단계별 모델 설정 (텍스트는 두 모드 공통, 이미지·편집은 openai 모드)
# [텍스트 생성 모델선택] 상품분석·전략·카피·QA·설명 (structured output 지원 모델만)
GENERATOR_TEXT_PROVIDER=openai        # openai | anthropic | google_genai
GENERATOR_TEXT_MODEL=gpt-4.1
# openai 예: gpt-4.1 | gpt-4o | gpt-4o-mini
# anthropic 예: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# google_genai 예: gemini-2.5-pro | gemini-2.5-flash | gemini-2.0-flash

# [이미지 생성 모델선택] 배경 이미지
GENERATOR_IMAGE_PROVIDER=openai         # openai | google_genai
GENERATOR_IMAGE_MODEL=gpt-image-1
# openai 예: gpt-image-1 | gpt-image-1-mini | gpt-image-2 | dall-e-3
# google_genai(Gemini 네이티브): gemini-3-pro-image | gemini-3.1-flash-image | gemini-2.5-flash-image
# google_genai(Imagen): imagen-4.0-ultra-generate-001 | imagen-4.0-generate-001 | imagen-4.0-fast-generate-001
GENERATOR_IMAGE_QUALITY=medium          # low | medium | high (openai 전용, 그 외는 무시)
GENERATOR_IMAGE_TIMEOUT=120             # 무거운 이미지 모델 대비 호출 타임아웃(초)

# [이미지 편집 모델선택] 누끼 배경제거 폴백 (현재 openai만 구현)
GENERATOR_IMAGE_EDIT_PROVIDER=openai        # openai | google_genai
GENERATOR_IMAGE_EDIT_MODEL=gpt-image-1
# openai 예: gpt-image-1 | gpt-image-1-mini
# google_genai 예: (현재 미구현)

# [작업별 이미지 모델 오버라이드] operation 단위 스위칭 (현재 openai만 구현, gemini 불가)
# 누끼(배경제거) — gemini는 투명알파 미보장이라 openai 전용. 비용 절감 시 gpt-image-1-mini 권장(벤치 후).
GENERATOR_CUTOUT_PROVIDER=openai          # openai 전용
GENERATOR_CUTOUT_MODEL=gpt-image-1        # 예: gpt-image-1 | gpt-image-1-mini | gpt-image-1.5
GENERATOR_CUTOUT_QUALITY=low              # low|medium|high (gpt-image 계열은 무시)
# 인페인팅(상품 마스크 잠금) — gemini는 마스크 API 없어 openai 전용. 품질 우선 시 gpt-image-1.5 권장(벤치 후).
GENERATOR_INPAINT_PROVIDER=openai         # openai 전용
GENERATOR_INPAINT_MODEL=gpt-image-1       # 예: gpt-image-1 | gpt-image-1.5 | gpt-image-1-mini

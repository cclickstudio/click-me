# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Database (NeonDB / PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ──────────────────────────────────────────────
# LLM — OpenAI
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# LLM — Anthropic
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# LLM — Google Gemini (채팅 어드바이저)
# ──────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ──────────────────────────────────────────────
# LangSmith (AI 파이프라인 트레이싱)
# ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=clickme-v2

# ──────────────────────────────────────────────
# AWS
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# S3
S3_BUCKET_NAME=clickme-assets

# SQS
SQS_SIMULATION_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/...
SQS_MAX_WORKERS=10

# ──────────────────────────────────────────────
# Simulation
# ──────────────────────────────────────────────
DEFAULT_PERSONA_COUNT=20
MAX_PERSONA_COUNT=1000

# ──────────────────────────────────────────────
# Meta / Instagram (Generator)
# ACCESS_TOKEN + INSTAGRAM_ACCOUNT_ID 둘 다 있어야 실제 게시, 없으면 Mock
# ──────────────────────────────────────────────
# App
META_APP_ID=
META_APP_SECRET=
# User
META_ACCESS_TOKEN=
META_USER_ID=
# Facebook Page
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram
META_INSTAGRAM_ACCOUNT_ID=
# Marketing (Phase 6 광고 집행용)
META_AD_ACCOUNT_ID=
# Config
META_GRAPH_API_VERSION=v23.0

# ──────────────────────────────────────────────
# Generator (광고 생성)
# ──────────────────────────────────────────────
# openai | anthropic | google_genai (그 외 LangChain provider는 langchain-<provider> 패키지 추가 설치 필요)
GENERATOR_TEXT_PROVIDER=anthropic
# openai: gpt-4.1 등 / anthropic: claude-sonnet-4-6 등 / google_genai: gemini-2.5-flash 등 (structured output 지원 모델만)
GENERATOR_TEXT_MODEL=claude-sonnet-4-6
# GENERATOR_TEXT_BASE_URL=              # 회사 OpenAI-호환 엔드포인트 사용 시
# openai | google_genai
GENERATOR_IMAGE_PROVIDER=google_genai
# openai: gpt-image-1 | gpt-image-1-mini | gpt-image-1.5 | gpt-image-2 | gpt-image-2-2026-04-21 | chatgpt-image-latest | dall-e-2 | dall-e-3
# google_genai(Gemini 네이티브, generateContent): gemini-3-pro-image | gemini-3-pro-image-preview | gemini-3.1-flash-image | gemini-3.1-flash-image-preview | gemini-2.5-flash-image
# google_genai(Imagen, generate_images — imagen- 접두사로 자동 분기): imagen-4.0-ultra-generate-001 | imagen-4.0-generate-001 | imagen-4.0-fast-generate-001
GENERATOR_IMAGE_MODEL=imagen-4.0-ultra-generate-001
# low | medium | high (openai 전용, google_genai는 무시됨)
GENERATOR_IMAGE_QUALITY=high
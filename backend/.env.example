# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Database (NeonDB / PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ──────────────────────────────────────────────
# LLM — OpenAI
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# LLM — Anthropic
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────
# LLM — Google Gemini (채팅 어드바이저)
# ──────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ──────────────────────────────────────────────
# LangSmith (AI 파이프라인 트레이싱)
# ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=clickme

# ──────────────────────────────────────────────
# AWS
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# S3
S3_BUCKET_NAME=clickme-assets

# SQS
SQS_SIMULATION_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/...
SQS_MAX_WORKERS=10

# ──────────────────────────────────────────────
# Simulation
# ──────────────────────────────────────────────
DEFAULT_PERSONA_COUNT=20
MAX_PERSONA_COUNT=1000

# ──────────────────────────────────────────────
# Meta / Instagram (Generator)
# ACCESS_TOKEN + INSTAGRAM_ACCOUNT_ID 둘 다 있어야 실제 게시, 없으면 Mock
# ──────────────────────────────────────────────
# App
META_APP_ID=
META_APP_SECRET=
# User
META_ACCESS_TOKEN=
META_USER_ID=
# Facebook Page
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram
META_INSTAGRAM_ACCOUNT_ID=
# Marketing (Phase 6 광고 집행용)
META_AD_ACCOUNT_ID=
# Config
META_GRAPH_API_VERSION=v23.0

# ──────────────────────────────────────────────
# Generator (광고 생성)
# ──────────────────────────────────────────────
# 생성 방식: pipeline=카피·이미지 단계 분리 / multimodal=한 모델이 이미지+카피 동시 생성
GENERATOR_GEN_MODE=pipeline             # pipeline | multimodal

# [텍스트] 상품분석·전략·카피·QA·설명 (structured output 지원 모델만)
# provider: openai | anthropic | google_genai (그 외 LangChain provider는 langchain-<provider> 패키지 추가 설치 필요)
GENERATOR_TEXT_PROVIDER=openai
GENERATOR_TEXT_MODEL=gpt-4.1
# anthropic 예: GENERATOR_TEXT_PROVIDER=anthropic / GENERATOR_TEXT_MODEL=claude-sonnet-4-6
# google_genai 예: GENERATOR_TEXT_PROVIDER=google_genai / GENERATOR_TEXT_MODEL=gemini-2.5-flash
# GENERATOR_TEXT_BASE_URL=              # 회사 OpenAI-호환 엔드포인트 사용 시

# [비전] 이미지 분석 (비전 지원 모델만)
GENERATOR_VISION_PROVIDER=openai
GENERATOR_VISION_MODEL=gpt-4o
# google_genai 예: GENERATOR_VISION_MODEL=gemini-2.5-flash

# [이미지 생성] 배경 이미지
GENERATOR_IMAGE_PROVIDER=openai         # openai | google_genai
GENERATOR_IMAGE_MODEL=gpt-image-1
# openai 예: gpt-image-1 | gpt-image-1-mini | gpt-image-2 | dall-e-3
# google_genai(Gemini 네이티브): gemini-3-pro-image | gemini-3.1-flash-image | gemini-2.5-flash-image
# google_genai(Imagen, imagen- 접두사로 자동 분기): imagen-4.0-ultra-generate-001 | imagen-4.0-generate-001 | imagen-4.0-fast-generate-001
GENERATOR_IMAGE_QUALITY=medium          # low | medium | high (openai 전용, 그 외는 무시)
GENERATOR_IMAGE_TIMEOUT=120             # 무거운 이미지 모델 대비 호출 타임아웃(초)

# [이미지 편집] 텍스트존 인페인팅 (현재 openai만 구현)
GENERATOR_IMAGE_EDIT_PROVIDER=openai
GENERATOR_IMAGE_EDIT_MODEL=gpt-image-1

# [멀티모달] 이미지+카피 동시 생성 — GENERATOR_GEN_MODE=multimodal 일 때만 사용
# GENERATOR_MULTIMODAL_PROVIDER=openai  # openai | google_genai
# GENERATOR_MULTIMODAL_MODEL=